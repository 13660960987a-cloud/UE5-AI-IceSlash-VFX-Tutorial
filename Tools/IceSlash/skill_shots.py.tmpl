import json
unreal.LevelSequenceEditorBlueprintLibrary.close_level_sequence()
await asyncio.sleep(0)
for i in range(1, 6):
    unreal.EditorAssetLibrary.save_asset('/Game/VFX/IceSlash/Meshes/SM_SlashArc_%02d' % i, True)
sub = unreal.get_editor_subsystem(unreal.EditorActorSubsystem)
acts = {a.get_actor_label(): a for a in sub.get_all_level_actors() if a.get_actor_label().startswith('IceSlash_')}
for l, a in acts.items():
    if l.startswith('IceSlash_Arc_') or l.startswith('IceSlash_Crystal_'):
        a.set_is_temporarily_hidden_in_editor(True)
comp = acts['IceSlash_NS_Skill'].niagara_component
unreal.ViewportService.set_game_view(True)
unreal.ViewportService.set_realtime(True)
comp.set_age_update_mode(unreal.NiagaraAgeUpdateMode.TICK_DELTA_TIME)
CAMS = __CAMS__
out = []
for t, cam in __SHOTS__:
    comp.set_paused(False)
    comp.reinitialize_system()
    await asyncio.sleep(0)
    comp.advance_simulation_by_time(t, 1.0 / 120.0)
    comp.set_paused(True)
    await asyncio.sleep(0)
    await asyncio.sleep(0)
    (x, y, z), pitch, yaw = CAMS[cam]
    name = '__PREFIX___t%04d' % int(round(t * 1000))
    r = unreal.ViewportService.capture_with_view(unreal.Vector(x, y, z), unreal.Rotator(roll=0, pitch=pitch, yaw=yaw), 960, 540, '/Users/mengmeile/Downloads/lianxi/m/Saved/VFX/shots/' + name + '.png', 55.0, True, 1.0)
    out.append([name, r.success, '' if r.success else r.error_message])
comp.set_paused(False)
comp.reinitialize_system()
for l, a in acts.items():
    if l.startswith('IceSlash_Arc_'):
        a.set_is_temporarily_hidden_in_editor(__SHOW_STATIC__)
unreal.ViewportService.set_game_view(False)
json.dumps(out)
